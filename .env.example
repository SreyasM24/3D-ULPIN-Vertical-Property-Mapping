# Application Configuration
APP_NAME="3D ULPIN & Vertical Property Mapping System"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# Database
# Default: Local SQLite (file: ./cadastre_3d.db)
# Production / PostGIS example: postgresql+psycopg://user:password@localhost:5432/cadastre_3d
DATABASE_URL="sqlite:///./cadastre_3d.db"
DB_ECHO=false

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Logging
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=false
